@startuml Платформа мониторинга поголовья MVP — System Context
!NEW_C4_STYLE=1

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

title Платформа мониторинга поголовья MVP — System Context

Person(central_management_operator, "Оператор центрального управления", "Анализирует события и планирует операции через Центральную систему управления фермами")
Person(farm_duty_employee, "Дежурный сотрудник фермы", "Находится на ферме, получает локальные уведомления, реагирует и управляет оборудованием")

System(livestock_monitoring_platform, "Платформа мониторинга поголовья MVP", "Объединяет Центральную систему управления фермами и Локальные операционные приложения ферм для мониторинга, управления оборудованием, автономной работы, надёжного хранения, восстановления данных и синхронизации")

note top of livestock_monitoring_platform
Канонические термины и границы определены в
[[https://github.com/vs-ya-practicum/01-MSA-AgroTech/blob/master/ubiquitous-language.md Ubiquitous Language]]
end note

System_Ext(erp_system, "ERP-система (1С:Агро)", "Существующая система персонала, аутентификации, авторизации и складских остатков корма")
System_Ext(uwb_rtls_system, "UWB/RTLS-система", "Готовое программно-аппаратное решение для идентификации, позиционирования, анализа движения и подсчёта")
System_Ext(farm_equipment, "Оборудование и устройства фермы", "Видеокамеры, кормушки, поилки и системы фильтрации воды")
System_Ext(wan_connectivity, "Интернет и WAN-каналы", "Основной и резервный интернет-каналы фермы")
System_Ext(external_metrics_consumer_system, "Внешняя система-потребитель метрик", "Получает базовые и пользовательские метрики")

Rel(central_management_operator, livestock_monitoring_platform, "Анализирует события через Центральную систему управления фермами")
Rel(livestock_monitoring_platform, central_management_operator, "Передаёт центральные уведомления")
Rel(livestock_monitoring_platform, farm_duty_employee, "Передаёт локальные уведомления независимо от доступности интернета")
Rel(erp_system, livestock_monitoring_platform, "Передаёт персонал, аутентификацию, авторизацию и остатки корма")
Rel(uwb_rtls_system, livestock_monitoring_platform, "Передаёт идентификаторы, положение, результаты анализа движения и подсчёта")
Rel(farm_equipment, livestock_monitoring_platform, "Передаёт видеопотоки, телеметрию и состояние")
Rel(livestock_monitoring_platform, farm_equipment, "Передаёт команды управления оборудованием")
Rel(livestock_monitoring_platform, wan_connectivity, "Синхронизируется через основной или резервный канал; работает локально при их недоступности")
Rel(livestock_monitoring_platform, external_metrics_consumer_system, "Передаёт базовые и пользовательские метрики")

@enduml
