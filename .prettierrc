{
    "semi": true,
    "printWidth": 200,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "bracketSpacing": true,
    "bracketSameLine": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["*.oas.json"],
            "options": {
                "tabWidth": 2,
                "useTabs": false
            }
        }
    ]
}
