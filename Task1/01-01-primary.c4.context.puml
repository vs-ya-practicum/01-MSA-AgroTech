@startuml MVP-система свиноферм — Основной вариант — System Context
!NEW_C4_STYLE=1

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()

title MVP-система свиноферм — Основной вариант — System Context

Person(operator, "Оператор", "Контролирует несколько ферм, анализирует События фермы и координирует устранение проблем")
Person(farmDutyEmployee, "Дежурный сотрудник фермы", "Работает на ферме, получает Локальные уведомления и выполняет Действия на ферме")

System(pigFarmSystem, "MVP-система свиноферм", "Центральная платформа и Агенты фермы. Агенты фермы продолжают локальную работу при отсутствии интернет-соединения и синхронизируют данные после восстановления связи.")

System_Ext(farmDevicesAndCameras, "Устройства и камеры фермы", "Кормушки, поилки, системы фильтрации воды и камеры на фермах")
System_Ext(existingKafka, "Существующий Kafka", "Существующий центральный брокер сообщений для асинхронной корпоративной интеграции")
System_Ext(dedicatedKafka, "Выделенный Kafka", "Облачная очередь асинхронной синхронизации ферм")

Rel(operator, pigFarmSystem, "Контролирует фермы, анализирует События фермы и координирует действия")
Rel(farmDutyEmployee, pigFarmSystem, "Получает Локальные уведомления и выполняет Действия на ферме")
BiRel(farmDevicesAndCameras, pigFarmSystem, "Передают телеметрию и видео; получают команды управления устройствами")
Rel(pigFarmSystem, existingKafka, "Публикует Опубликованные метрики")
Rel(pigFarmSystem, dedicatedKafka, "Синхронизирует данные ферм")

@enduml
