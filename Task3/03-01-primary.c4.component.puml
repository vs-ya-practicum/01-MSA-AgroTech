@startuml Платформа мониторинга поголовья MVP — Primary Component
!NEW_C4_STYLE=1

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

title Платформа мониторинга поголовья MVP — Primary Component

Person(central_management_operator, "Оператор центрального управления", "Анализирует события, организует пополнение корма и планирует операции")
Person(farm_duty_employee, "Дежурный сотрудник фермы", "Получает Локальные уведомления и управляет оборудованием")

Container_Boundary(farm_local_operations_application, "Локальное операционное приложение фермы") {
    Component(local_processing_and_control, "Модуль локальной обработки и управления", "Application component", "Обрабатывает локальные сигналы, создаёт Локальные уведомления и управляет оборудованием")
    Component(synchronization_module, "Модуль синхронизации", "Application component", "Передаёт накопленные данные и предотвращает потерю или повторную обработку")
    Component(connectivity_management_module, "Модуль управления подключением", "Application component", "Переключает основной и резервный WAN-каналы")
    Component(mqtt_adapter, "MQTT-адаптер", "MQTT client", "Получает события и состояние; публикует запросы управления")
}

Container_Boundary(central_farm_management_system, "Центральная система управления фермами") {
    Component(central_mqtt_message_handler, "Обработчик сообщений MQTT", "Application component", "Принимает операционные данные; публикует команды и подтверждения")
    Component(central_operations_management, "Модуль центрального управления операциями", "Application component", "Управляет фермами, ролями, командами и операционной аналитикой")
    Component(erp_read_integration, "Адаптер чтения ERP", "REST/HTTPS client", "Запрашивает персонал, доступ и остатки корма только для чтения")
    Component(metrics_export_adapter, "Адаптер экспорта метрик", "HTTPS/JSON client", "Экспортирует базовые и пользовательские метрики")
}

ContainerDb(local_operational_data_store, "Локальное операционное хранилище данных", "", "Операционные данные, состояния, Исходящие уведомления и outbox")
ContainerDb(central_operational_data_store, "Центральное операционное хранилище данных", "", "Синхронизированные операционные данные")
Container_Ext(local_mqtt_broker, "Локальный MQTT-брокер", "MQTT, QoS 1", "Локальная шина событий и команд")
Container_Ext(central_mqtt_broker, "Центральный MQTT-брокер", "MQTT over TLS, QoS 1", "Синхронизация ферм, команды и подтверждения")
Container_Ext(wan_connectivity, "Внешняя связь фермы", "Основной и резервный каналы")
System_Ext(erp_system, "ERP-система 1С:Агро", "Персонал, доступ, корм")
System_Ext(external_metrics_consumer_system, "Внешняя система-потребитель метрик", "Метрики")

Rel(central_management_operator, central_operations_management, "Анализирует события, организует пополнение корма и планирует операции")
Rel(farm_duty_employee, local_processing_and_control, "Получает Локальные уведомления и запрашивает управление")
Rel(local_mqtt_broker, mqtt_adapter, "События и состояние", "MQTT, QoS 1")
Rel(mqtt_adapter, local_mqtt_broker, "Запросы управления", "MQTT, QoS 1")
Rel(mqtt_adapter, local_processing_and_control, "Передаёт события, состояние и результаты команд")
Rel(local_processing_and_control, mqtt_adapter, "Передаёт запросы управления")
Rel(local_processing_and_control, local_operational_data_store, "Сохраняет операционные данные и Исходящие уведомления")
Rel(synchronization_module, local_operational_data_store, "Читает outbox и подтверждает доставку")
Rel(connectivity_management_module, synchronization_module, "Сообщает о доступности WAN")
Rel(connectivity_management_module, wan_connectivity, "Переключает каналы")
Rel(synchronization_module, central_mqtt_broker, "Накопленные операционные данные", "MQTT over TLS, QoS 1")
Rel(central_mqtt_broker, synchronization_module, "Команды и подтверждения", "MQTT over TLS, QoS 1")
Rel(central_mqtt_broker, central_mqtt_message_handler, "Операционные данные", "MQTT, QoS 1")
Rel(central_mqtt_message_handler, central_mqtt_broker, "Команды и подтверждения", "MQTT, QoS 1")
Rel(central_mqtt_message_handler, central_operations_management, "Передаёт операционные данные")
Rel(central_operations_management, central_mqtt_message_handler, "Передаёт команды и подтверждения")
Rel(central_operations_management, central_operational_data_store, "Сохраняет и читает синхронизированные операционные данные")
Rel(central_operations_management, erp_read_integration, "Запрашивает данные персонала, доступа и корма")
Rel(erp_read_integration, erp_system, "Запрашивает данные только для чтения", "REST/HTTPS")
Rel(central_operations_management, metrics_export_adapter, "Передаёт базовые и пользовательские метрики")
Rel(metrics_export_adapter, external_metrics_consumer_system, "Экспортирует метрики", "HTTPS/JSON")

@enduml
