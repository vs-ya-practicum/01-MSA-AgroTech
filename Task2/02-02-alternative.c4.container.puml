@startuml MVP-система свиноферм — Альтернативный вариант — Container
!NEW_C4_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
title MVP-система свиноферм — Альтернативный вариант — Container
LAYOUT_WITH_LEGEND()
SHOW_PERSON_OUTLINE()

Person(operator, "Оператор", "Контролирует несколько ферм, анализирует События фермы и координирует действия")
Person(farmDutyEmployee, "Дежурный сотрудник фермы", "Получает Локальные уведомления и реагирует на проблемы фермы")
System_Ext(existingKafka, "Существующий Kafka", "Центральный брокер для асинхронной корпоративной интеграции")
System_Ext(existingIotGateway, "Существующий IoT-шлюз", "Внешний центральный шлюз, расширенный Центральным сервисом синхронизации")
System_Ext(timescaleDb, "TimescaleDB", "Внешняя база данных, расширенная данными и схемой свиноводческих ферм")

System_Boundary(centralPlatformBoundary, "Граница Центральной платформы") {
    Container(centralPlatform, "Центральная платформа", "Прикладная платформа", "Предоставляет центральные операции, учёт кормов и прогнозирование, а также публикует Опубликованные метрики")
    ContainerDb(centralS3, "Центральное S3 (MinIO)", "Объектное хранилище", "Хранит выбранные видео- и аудиофрагменты инцидентов и аудита-свидетельства")
}

System_Boundary(farmBoundary, "Граница фермы") {
    System_Ext(farmDevices, "Устройства и камеры фермы", "Кормушки, поилки, системы фильтрации воды и камеры разных производителей")
    Container(farmAgent, "Агент фермы", "Локальное программно-аппаратное решение", "Работает автономно на ферме: получает телеметрию и видео, управляет устройствами, обнаруживает инциденты, отправляет Локальные уведомления и синхронизирует данные после восстановления связи")
    ContainerDb(localStorage, "Локальное хранилище", "Локальная база данных", "Хранит телеметрию, События фермы, метаданные свидетельств и состояние синхронизации при отсутствии связи; используется Локальным буфером")
    ContainerDb(localS3, "Локальное S3 (MinIO)", "Локальное объектное хранилище", "Хранит выбранные видео- и аудиофрагменты инцидентов и аудита-свидетельства при отсутствии связи")
}

Rel(operator, centralPlatform, "Использует", "HTTPS")
Rel(farmDutyEmployee, farmAgent, "Получает Локальные уведомления")
Rel(farmDevices, farmAgent, "Передают телеметрию и видеопотоки; получают команды управления", "Протоколы производителей")
Rel(farmAgent, existingIotGateway, "Локальный сервис синхронизации передаёт локально сохранённые данные после восстановления связи", "Выбранный надёжный транспорт; не более 10 минут при нормальном соединении")
Rel(existingIotGateway, timescaleDb, "Сохраняет синхронизированные данные ферм", "SQL")
Rel(centralPlatform, existingIotGateway, "Получает синхронизированные данные ферм", "Внутренний API")
Rel(centralPlatform, timescaleDb, "Читает данные для центральных операций и прогнозирования", "SQL")
Rel(centralPlatform, centralS3, "Сохраняет и читает центральные свидетельства", "S3 API")
Rel(farmAgent, localStorage, "Локальный буфер сохраняет и читает структурированные данные", "Локальная база данных")
Rel(farmAgent, localS3, "Сохраняет и читает локальные свидетельства", "S3 API")
Rel(centralPlatform, existingKafka, "Публикует Опубликованные метрики", "Асинхронный Kafka")

note "Локальные уведомления и управление устройствами выполняются внутри Агента фермы и не зависят от интернет-соединения или Kafka.\nОт обнаружения Видеоаналитикой до Локального уведомления проходит не более 5 секунд." as n1
n1 .. farmAgent
@enduml
